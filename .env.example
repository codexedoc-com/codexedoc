# ==============================================================================
# CODEXEDOC — Environment Configuration Template
# ==============================================================================
#
# This file defines all environment variables required by the CODEXEDOC Learning
# Operating System.
#
# FOR LOCAL DEVELOPMENT (Community Mode):
# Copy this file to `.env.local`:
#   cp .env.example .env.local
#
# By default, USE_AUTH=false enables Community Mode — allowing you to run, test,
# and contribute to the application immediately with ZERO external API keys or
# database connection strings.
#
# @see ADR-002 — Authentication Architecture
# @see ADR-003 — Project Structure & Environment Isolation
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION MODE
# ------------------------------------------------------------------------------
# Governs the active authentication provider across the system.
#
# Values:
#   false = Community Mode (Default for local development)
#           - Injects LocalDevAuthProvider.
#           - Zero external credentials required.
#           - Deterministic mock user ("mock-user") automatically authenticated.
#           - Safe for open-source contributors.
#
#   true  = Enforced Auth Mode (Staging & Production)
#           - Injects ProductionAuthProvider.
#           - Enforces HTTP-only cookies, session tokens, and cryptographic checks.
#           - Requires AUTH_SECRET to be configured below.
#           - Rejecting false in production builds (NODE_ENV=production).
#
USE_AUTH=false

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION SECRETS (Required ONLY if USE_AUTH=true)
# ------------------------------------------------------------------------------
# Secret key used for cryptographic token verification and hashing.
#
# Community Mode (USE_AUTH=false):
#   - Ignored completely.
#
# Production Mode (USE_AUTH=true):
#   - MANDATORY. Must be a secure random string (at least 32 characters).
#   - Example generation: openssl rand -base64 32
#
AUTH_SECRET=your-32-character-random-auth-secret-here

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Connection string for the PostgreSQL database (Neon or local Docker).
#
# Community Mode (USE_AUTH=false):
#   - Defaults to local PostgreSQL development instance or mock data provider.
#
# Production Mode (USE_AUTH=true):
#   - Production database cluster URL.
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codexedoc_dev

# ------------------------------------------------------------------------------
# 4. APPLICATION METADATA & URLS
# ------------------------------------------------------------------------------
# Canonical base URL for Next.js server actions, absolute redirects, and CORS.
#
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session duration in seconds (Default: 604800 = 7 days)
SESSION_DURATION_SECONDS=604800

# ------------------------------------------------------------------------------
# 5. EXTERNAL IDENTITY & EMAIL PROVIDERS (Optional / Staging / Production)
# ------------------------------------------------------------------------------
# Third-party integrations for passwordless email auth and bot protection.
#
# Community Mode (USE_AUTH=false):
#   - Ignored. Mock auth automatically bypasses external network calls.
#
# Production Mode (USE_AUTH=true):
#   - Resend API key for magic link delivery.
#   - Cloudflare Turnstile site key & secret for bot verification.
#
RESEND_API_KEY=re_your_resend_api_key_placeholder
EMAIL_FROM="CODEXEDOC <verify@codexedoc.com>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-placeholder
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-placeholder
